# Versions et identités du bootstrap local.
# Les versions du bootstrap sont centralisées dans ce fichier.

# -----------------------------------------------------------------------------
# Instance du bootstrap
# -----------------------------------------------------------------------------

PLATFORM_BOOTSTRAP_NAME="${PLATFORM_BOOTSTRAP_NAME:-platform}"

# -----------------------------------------------------------------------------
# Kubernetes / Kind
# -----------------------------------------------------------------------------

KUBERNETES_VERSION="${KUBERNETES_VERSION:-v1.37.0}"
KIND_NODE_IMAGE="${KIND_NODE_IMAGE:-kindest/node:v1.37.0}"

KIND_CLUSTER_PREFIX="${KIND_CLUSTER_PREFIX:-}"
KIND_CLUSTER_SUFFIX="${KIND_CLUSTER_SUFFIX:-}"

KIND_CLUSTER="${KIND_CLUSTER:-${KIND_CLUSTER_PREFIX}${PLATFORM_BOOTSTRAP_NAME}${KIND_CLUSTER_SUFFIX}}"

KIND_HTTP_PORT="${KIND_HTTP_PORT:-80}"
KIND_HTTPS_PORT="${KIND_HTTPS_PORT:-443}"

# -----------------------------------------------------------------------------
# Registry OCI
# -----------------------------------------------------------------------------

REGISTRY_NAME_PREFIX="${REGISTRY_NAME_PREFIX:-}"
REGISTRY_NAME_SUFFIX="${REGISTRY_NAME_SUFFIX:--registry}"

REGISTRY_HOST_PREFIX="${REGISTRY_HOST_PREFIX:-registry.}"
REGISTRY_HOST_SUFFIX="${REGISTRY_HOST_SUFFIX:-.local}"

REGISTRY_NAME="${REGISTRY_NAME:-${REGISTRY_NAME_PREFIX}${PLATFORM_BOOTSTRAP_NAME}${REGISTRY_NAME_SUFFIX}}"
REGISTRY_HOST="${REGISTRY_HOST:-${REGISTRY_HOST_PREFIX}${PLATFORM_BOOTSTRAP_NAME}${REGISTRY_HOST_SUFFIX}}"

REGISTRY_PORT="${REGISTRY_PORT:-5000}"
REGISTRY_IMAGE="${REGISTRY_IMAGE:-registry:2}"
REGISTRY_CERT_DAYS="${REGISTRY_CERT_DAYS:-365}"

# -----------------------------------------------------------------------------
# Crossplane
# -----------------------------------------------------------------------------

CROSSPLANE_VERSION="${CROSSPLANE_VERSION:-2.4.0}"
CROSSPLANE_FUNCTION_PATCH_AND_TRANSFORM_VERSION="${CROSSPLANE_FUNCTION_PATCH_AND_TRANSFORM_VERSION:-v0.8.2}"